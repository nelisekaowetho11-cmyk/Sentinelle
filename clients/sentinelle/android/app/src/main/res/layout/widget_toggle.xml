<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget face. Kept to a small, fixed set of views because RemoteViews only
  supports a handful of widget types and no custom drawing at all.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <!-- The orb: a filled circle whose colour is the whole state indicator. -->
    <FrameLayout
        android:id="@+id/widget_orb"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/widget_orb_off" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="13dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Not connected"
            android:textColor="@color/veil_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tap to connect"
            android:textColor="@color/veil_muted"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
